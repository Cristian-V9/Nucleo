<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nucleo">

        <!-- Pantalla de bienvenida: es la que abre el lanzador. -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nucleo.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Acceso: inicio de sesión, registro y recuperación de contraseña. -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Una Activity por rol, cada una con su tema y su barra de navegación. -->
        <activity
            android:name=".ui.comprador.CompradorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nucleo.Comprador"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.vendedor.VendedorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nucleo.Vendedor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nucleo.Admin"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
