<?xml version="1.0" encoding="utf-8"?>
<!-- Barra fija inferior con una línea superior de separación (layer-list). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/borde" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_barra" />
        </shape>
    </item>
</layer-list>
