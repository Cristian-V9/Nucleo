<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del mapa: fondo con dos "calles" dibujadas con capas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/borde" />
            <corners android:radius="@dimen/radio_l" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:height="10dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie_alta" />
        </shape>
    </item>
    <item android:gravity="start" android:left="56dp" android:top="1dp" android:bottom="1dp" android:width="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie_alta" />
        </shape>
    </item>
</layer-list>
