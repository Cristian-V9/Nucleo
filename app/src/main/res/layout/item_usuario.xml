<?xml version="1.0" encoding="utf-8"?>
<!-- Usuario en la lista del administrador: iniciales, rol, estado y acciones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="@dimen/espacio_m"
        android:paddingEnd="@dimen/espacio_xs">

        <TextView
            android:id="@+id/iniciales"
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="@drawable/bg_circulo"
            android:gravity="center"
            android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:textAppearance="@style/Texto.Nucleo.Secundario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/estado"
                    style="@style/Widget.Nucleo.Pildora" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEditar"
            style="@style/Widget.Nucleo.BotonIcono.Plano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editar"
            app:icon="@drawable/ic_editar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEliminar"
            style="@style/Widget.Nucleo.BotonIcono.Plano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/eliminar"
            app:icon="@drawable/ic_eliminar"
            app:iconTint="@color/error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
