<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de las pantallas principales: etiqueta del rol, título y una acción opcional. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margen_pantalla"
    android:paddingTop="@dimen/margen_pantalla"
    android:paddingBottom="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pildoraRol"
            style="@style/Widget.Nucleo.Pildora.Rol" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:textAppearance="@style/Texto.Nucleo.Secundario"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:textAppearance="@style/Texto.Nucleo.Titulo" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonAccion"
        style="@style/Widget.Nucleo.BotonIcono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
