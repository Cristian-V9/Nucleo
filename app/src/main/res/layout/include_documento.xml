<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque para adjuntar un documento legal con la cámara o como PDF. Se reutiliza para el RUT y la matrícula. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_borde_punteado"
    android:orientation="vertical"
    android:padding="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/fondoIcono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_aviso"
            android:backgroundTint="@color/superficie_alta">

            <ImageView
                android:id="@+id/icono"
                android:layout_width="@dimen/icono_s"
                android:layout_height="@dimen/icono_s"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_documento"
                app:tint="@color/texto_secundario" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/documento_sin_cargar"
                android:textAppearance="@style/Texto.Nucleo.Secundario"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonFoto"
            style="@style/Widget.Nucleo.Boton.Pequeno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1"
            android:text="@string/tomar_foto"
            app:icon="@drawable/ic_camara"
            app:iconSize="@dimen/icono_s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonPdf"
            style="@style/Widget.Nucleo.Boton.Contorno.Pequeno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_s"
            android:layout_weight="1"
            android:text="@string/subir_pdf"
            app:icon="@drawable/ic_documento"
            app:iconSize="@dimen/icono_s" />
    </LinearLayout>
</LinearLayout>
