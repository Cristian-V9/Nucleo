<?xml version="1.0" encoding="utf-8"?>
<!-- Gestión de productos del administrador: ver todas las publicaciones y ocultarlas (RF-05). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/include_encabezado_rol" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_pantalla"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_buscar">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/buscar_hint"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_s"
        app:checkedChip="@id/chipTodas"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTodas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todas" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVisibles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visibles" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOcultas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ocultas" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_m"
        android:paddingBottom="@dimen/espacio_l"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
