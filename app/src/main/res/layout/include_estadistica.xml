<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de indicador del panel (etiqueta, cifra e ícono). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tarjeta"
    android:orientation="vertical"
    android:padding="@dimen/espacio_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Texto.Nucleo.Secundario"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/icono"
            android:layout_width="@dimen/icono_s"
            android:layout_height="@dimen/icono_s"
            android:importantForAccessibility="no"
            app:tint="?attr/colorRol" />
    </LinearLayout>

    <TextView
        android:id="@+id/valor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:textAppearance="@style/Texto.Nucleo.Cifra" />
</LinearLayout>
