<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de producto del catálogo (cuadrícula de 2 columnas). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_imagen_tarjeta"
            android:background="@drawable/bg_imagen_producto">

            <ImageView
                android:id="@+id/icono"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/icono_producto" />
        </FrameLayout>

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:ellipsize="end"
            android:lines="2"
            android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:textAppearance="@style/Texto.Nucleo.Precio"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/comercios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Texto.Nucleo.Secundario"
            android:textSize="@dimen/texto_pequeno" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
