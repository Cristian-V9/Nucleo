<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle del producto: ficha técnica y comparación de precios entre comercios (RF-02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/include_encabezado" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_imagen_detalle"
                android:layout_marginTop="@dimen/espacio_s"
                android:background="@drawable/bg_imagen_producto">

                <ImageView
                    android:id="@+id/icono"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:tint="@color/icono_producto" />
            </FrameLayout>

            <TextView
                android:id="@+id/textoCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:textAppearance="@style/Texto.Nucleo.Etiqueta"
                android:textColor="?attr/colorRol"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:textAppearance="@style/Texto.Nucleo.Titulo"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:text="@string/ficha_tecnica"
                android:textAppearance="@style/Texto.Nucleo.Subtitulo"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:layout_marginTop="@dimen/espacio_s"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

            <TextView
                android:id="@+id/textoDisponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:textAppearance="@style/Texto.Nucleo.Subtitulo"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior fija con el comercio elegido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingVertical="@dimen/espacio_m">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoComercioElegido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.Nucleo.Secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textoPrecioElegido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.Nucleo.Subtitulo"
                android:textSize="20sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAgregar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_l"
            android:layout_weight="1"
            android:text="@string/agregar_carrito"
            app:icon="@drawable/ic_carrito"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
