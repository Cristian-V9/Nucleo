<?xml version="1.0" encoding="utf-8"?>
<!-- Columna de la gráfica de ventas: valor, barra (su alto se calcula en código) y mes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/valor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Texto.Nucleo.Secundario"
        android:textSize="10sp" />

    <View
        android:id="@+id/barra"
        android:layout_width="22dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/espacio_xs"
        android:background="@drawable/bg_barra_grafica" />

    <TextView
        android:id="@+id/mes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:textAppearance="@style/Texto.Nucleo.Secundario"
        android:textSize="12sp" />
</LinearLayout>
