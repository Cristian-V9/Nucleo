<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del reporte: nombre, valor vendido y barra de proporción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Texto.Nucleo.Cuerpo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Texto.Nucleo.Secundario"
        android:textSize="12sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/proporcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:indicatorColor="?attr/colorRol"
        app:trackColor="@color/superficie_alta"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />
</LinearLayout>
