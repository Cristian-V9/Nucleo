<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo: búsqueda por nombre, filtro por categoría y orden por precio (RF-02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/include_encabezado_rol" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_pantalla"
        android:hint="@string/buscar_hint"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_buscar">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/buscar_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoCategorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipTodos"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todos" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textoResultados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Texto.Nucleo.Secundario" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoOrden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/botonMenorPrecio"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonMenorPrecio"
                style="@style/Widget.Nucleo.Boton.Alternar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/menor_precio" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonMayorPrecio"
                style="@style/Widget.Nucleo.Boton.Alternar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/mayor_precio" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaProductos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="@dimen/espacio_s"
            android:paddingBottom="@dimen/espacio_l"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

        <TextView
            android:id="@+id/textoVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/sin_resultados"
            android:textAppearance="@style/Texto.Nucleo.Secundario"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
