<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso informativo reutilizable: ícono + texto sobre un fondo suave. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aviso"
    android:backgroundTint="@color/primario_suave"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_m">

    <ImageView
        android:id="@+id/iconoAviso"
        android:layout_width="@dimen/icono_s"
        android:layout_height="@dimen/icono_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/primario_claro" />

    <TextView
        android:id="@+id/textoAviso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_s"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:textAppearance="@style/Texto.Nucleo.Secundario"
        android:textColor="@color/texto_etiqueta"
        android:textSize="12sp" />
</LinearLayout>
