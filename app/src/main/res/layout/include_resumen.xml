<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen de valores del pedido: subtotal, envío y total. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tarjeta"
    android:orientation="vertical"
    android:padding="@dimen/espacio_l">

    <include
        android:id="@+id/filaSubtotal"
        layout="@layout/include_fila_total" />

    <include
        android:id="@+id/filaEnvio"
        layout="@layout/include_fila_total" />

    <View
        style="@style/Widget.Nucleo.Separador"
        android:layout_marginVertical="@dimen/espacio_s" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/total"
            android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita" />

        <TextView
            android:id="@+id/textoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.Nucleo.Cifra" />
    </LinearLayout>
</LinearLayout>
