<?xml version="1.0" encoding="utf-8"?>
<!-- Producto dentro del carrito con selector de cantidad. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_m">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_imagen_producto">

            <ImageView
                android:id="@+id/icono"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/icono_producto" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:maxLines="3"
                    android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonQuitar"
                    style="@style/Widget.Nucleo.BotonIcono.Plano"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="36dp"
                    android:minHeight="36dp"
                    android:contentDescription="@string/quitar_producto"
                    app:icon="@drawable/ic_eliminar"
                    app:iconTint="@color/error" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/precio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/Texto.Nucleo.Precio" />

                <!-- Selector de cantidad -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_imagen_producto"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonMenos"
                        style="@style/Widget.Nucleo.BotonIcono.Plano"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:minWidth="40dp"
                        android:minHeight="40dp"
                        android:contentDescription="@string/disminuir"
                        app:icon="@drawable/ic_menos"
                        app:iconTint="@color/texto" />

                    <TextView
                        android:id="@+id/cantidad"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/Texto.Nucleo.Cuerpo.Negrita" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonMas"
                        style="@style/Widget.Nucleo.BotonIcono.Plano"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:minWidth="40dp"
                        android:minHeight="40dp"
                        android:contentDescription="@string/aumentar"
                        app:icon="@drawable/ic_agregar"
                        app:iconTint="@color/texto" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
