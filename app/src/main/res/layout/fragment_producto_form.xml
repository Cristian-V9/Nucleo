<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario para crear o editar un producto, con fotos desde la cámara o la galería (RF-06). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/encabezado"
        layout="@layout/include_encabezado" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:text="@string/fotos_producto"
                android:textAppearance="@style/Texto.Nucleo.Etiqueta" />

            <!-- Fotos: dos botones y tres espacios para vistas previas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/espacio_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonCamara"
                    style="@style/Widget.Nucleo.Boton.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:text="@string/tomar_foto"
                    android:textColor="@color/acento_vendedor"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_camara"
                    app:iconGravity="top"
                    app:iconPadding="6dp"
                    app:iconTint="@color/acento_vendedor"
                    app:strokeColor="@color/acento_vendedor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonGaleria"
                    style="@style/Widget.Nucleo.Boton.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:text="@string/galeria"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_galeria"
                    app:iconGravity="top"
                    app:iconPadding="6dp" />

                <LinearLayout
                    android:id="@+id/contenedorFotos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:background="@drawable/bg_borde_punteado"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xs">

                    <TextView
                        android:id="@+id/textoSinFotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/maximo_fotos"
                        android:textAppearance="@style/Texto.Nucleo.Secundario"
                        android:textSize="@dimen/texto_pequeno" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:hint="@string/nombre_producto">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Lista desplegable de categorías (Exposed Dropdown Menu) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoCategoria"
                    style="@style/Widget.Nucleo.CampoTexto.Lista"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1.2"
                    android:hint="@string/categoria">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/listaCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoMarca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:hint="@string/marca">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoReferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:hint="@string/referencia">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:hint="@string/precio_cop"
                    app:prefixText="$ ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="9"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoStock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:hint="@string/stock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:hint="@string/ficha_tecnica_hint"
                app:helperText="@string/ficha_tecnica_ayuda">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/aviso"
                layout="@layout/include_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margen_pantalla"
        android:text="@string/guardar_publicar" />
</LinearLayout>
